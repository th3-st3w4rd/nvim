--         }))
--       end
--     end,
--   },
return {
  {
    "ms-jpq/coq_nvim",
    branch = "coq",
    event = "VimEnter", -- Defers loading until AFTER lazy.nvim's coroutine startup finishes
    init = function()
      vim.g.coq_settings = {
        auto_start = "shut-up",
      }
    end,
    config = function()
      -- COQ automatically loads its runtime, but requiring it here forces it outside coroutines
      require("coq")
    end,
  },

  {
    "ms-jpq/coq.artifacts",
    branch = "artifacts",
    event = "VimEnter",
  },

  {
    "ms-jpq/coq.thirdparty",
    branch = "3p",
    event = "VimEnter",
  },

  {
    "neovim/nvim-lspconfig",
    event = "VimEnter",
    config = function()
      local coq = require("coq")
      local lspconfig = require("lspconfig")

      local servers = { "lua_ls", "pyright", "ts_ls" } -- Replace with your LSP servers

      for _, lsp in ipairs(servers) do
        lspconfig[lsp].setup(coq.lspensure({
          -- Standard server configs go here
        }))
      end
    end,
  },
}
